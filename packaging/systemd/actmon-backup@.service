[Unit]
RequiresMountsFor=/home/%i/.local/share/actmon
Description=Verified local Actmon snapshot for %i
After=actmon@%i.service

[Service]
Type=oneshot
User=%i
UMask=0077
Environment="ACTMON_DATABASE=/home/%i/.local/share/actmon/activity.db"
Environment="ACTMON_BACKUP_DIRECTORY=/home/%i/.local/share/actmon/backups"
EnvironmentFile=/etc/actmon/%i.env
ExecStart=/usr/local/bin/actmon backup --database ${ACTMON_DATABASE} --destination ${ACTMON_BACKUP_DIRECTORY}
# Longer than the command's 300-second cooperative deadline; still bounds a hang.
TimeoutStartSec=10min
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/%i/.local/share/actmon
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
