[Unit]
RequiresMountsFor=/home/invictus/.local/share/actmon
Description=Verified local Actmon snapshot
After=actmon.service

[Service]
Type=oneshot
User=invictus
UMask=0077
Environment="ACTMON_DATABASE=/home/invictus/.local/share/actmon/activity.db"
Environment="ACTMON_BACKUP_DIRECTORY=/home/invictus/.local/share/actmon/backups"
EnvironmentFile=/etc/actmon/invictus.env
ExecStart=/usr/local/bin/actmon backup --database ${ACTMON_DATABASE} --destination ${ACTMON_BACKUP_DIRECTORY}
# Longer than the command's 300-second cooperative deadline; still bounds a hang.
TimeoutStartSec=10min
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/invictus/.local/share/actmon
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
