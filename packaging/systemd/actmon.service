[Unit]
RequiresMountsFor=/home/invictus/.local/share/actmon
Description=Actmon input activity recorder
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=invictus
SupplementaryGroups=actmon-input
UMask=0077
Environment="ACTMON_DATABASE=/home/invictus/.local/share/actmon/activity.db"
Environment="ACTMON_KEYBOARD_NAME=keyboard-debouncer"
EnvironmentFile=/etc/actmon/invictus.env
ExecStart=/usr/local/bin/actmon collect --database ${ACTMON_DATABASE} --keyboard-name ${ACTMON_KEYBOARD_NAME} --mouse-name ${ACTMON_MOUSE_NAME}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/invictus/.local/share/actmon
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=char-input r

[Install]
WantedBy=multi-user.target
Also=actmon-backup.timer
